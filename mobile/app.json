{
  "expo": {
    "name": "Dy Khoa Campus",
    "slug": "dy-khoa-campus",
    "scheme": "dykhoacampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4C81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.dykhoa.campus",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng dùng camera để quét mã QR điểm danh.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.edu.dykhoa.campus",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0F4C81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Dy Khoa Campus dùng camera để quét mã QR điểm danh."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
