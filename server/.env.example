# Cổng HTTP của API
PORT=4000

# Bí mật ký JWT — BẮT BUỘC đổi khi chạy thật (>= 32 ký tự)
JWT_SECRET=dev-only-change-me-dy-khoa-campus-secret-key

# Bí mật ký payload mã QR — tách riêng khỏi JWT_SECRET
QR_SECRET=dev-only-change-me-dy-khoa-campus-qr-key

# Hạn dùng token
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Hạn dùng mã QR (giây). QR xoay vòng liên tục nên để ngắn.
SESSION_QR_TTL_SEC=30
STUDENT_QR_TTL_SEC=60

# Dung sai lệch giờ giữa máy chủ và điện thoại (giây)
QR_CLOCK_SKEW_SEC=10

# Đường dẫn tệp CSDL SQLite
DATABASE_FILE=./data/campus.db

# Nguồn gốc được phép gọi API (web app), phân tách bằng dấu phẩy. * = mọi nguồn.
CORS_ORIGIN=*
